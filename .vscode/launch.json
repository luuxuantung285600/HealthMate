{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HealthMate App (Web - Chrome)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/config/chat-api.json",
                "--dart-define-from-file=${workspaceFolder}/config/admin-runtime.json"
            ]
        },
        {
            "name": "HealthMate App (Web - Edge)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "edge",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/config/chat-api.json",
                "--dart-define-from-file=${workspaceFolder}/config/admin-runtime.json"
            ]
        },
        {
            "name": "HealthMate App (Android)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "preLaunchTask": "HealthMate: prepare Android debug",
            "toolArgs": [
                "--dart-define-from-file=${env:LOCALAPPDATA}/HealthMate/vscode-android-debug.json"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "HealthMate Admin (localhost:4173)",
            "preLaunchTask": "HealthMate: start admin local",
            "url": "http://127.0.0.1:4173",
            "webRoot": "${workspaceFolder}/admin-web/dist"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "HealthMate Admin (online)",
            "url": "https://healthmate-admin-vn.web.app",
            "webRoot": "${workspaceFolder}/admin-web/dist"
        }
    ]
}
