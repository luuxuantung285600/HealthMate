# Copy to a private .env.<firebase-project-id>, never to the Flutter app.
# Keep disabled until Play Console products, permissions, App Check and sandbox
# acceptance are complete. Values below intentionally do not create a product.
BILLING_ENABLED=false
BILLING_PACKAGE_NAME=
BILLING_PRODUCT_ID=
BILLING_BASE_PLAN_ID=
BILLING_ALLOW_TEST=false
